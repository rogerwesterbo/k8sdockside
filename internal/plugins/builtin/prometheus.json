{
    "id": "prometheus",
    "name": "Prometheus",
    "tagline": "monitoring, as the Prometheus Operator installs it",
    "icon": "gauge",
    "docs": "https://prometheus-operator.dev/docs/getting-started/introduction/",
    "description": "The Prometheus Operator turns monitoring into Kubernetes objects: a Prometheus is a running server, and the ServiceMonitors, PodMonitors and ScrapeConfigs around it are what it has been told to scrape. This plugin also draws the graphs on pods, nodes and the cluster dashboard \u2014 those queries assume the metric and label names the kube-prometheus-stack sets up (cAdvisor with a node label, kube-state-metrics). If your Prometheus is set up differently, copy this plugin into your own plugins folder under the same id and change the queries.",
    "requires": [
        {
            "kind": "crd:prometheuses.monitoring.coreos.com",
            "label": "Prometheus servers"
        },
        {
            "kind": "crd:servicemonitors.monitoring.coreos.com",
            "label": "Service Monitors"
        },
        {
            "kind": "crd:alertmanagers.monitoring.coreos.com",
            "label": "Alertmanagers",
            "optional": true
        }
    ],
    "views": [
        {
            "id": "servers",
            "label": "Prometheus servers",
            "icon": "server",
            "kind": "crd:prometheuses.monitoring.coreos.com"
        },
        {
            "id": "alertmanagers",
            "label": "Alertmanagers",
            "icon": "bell",
            "kind": "crd:alertmanagers.monitoring.coreos.com"
        },
        {
            "id": "servicemonitors",
            "label": "Service Monitors",
            "icon": "share",
            "kind": "crd:servicemonitors.monitoring.coreos.com"
        },
        {
            "id": "podmonitors",
            "label": "Pod Monitors",
            "icon": "box",
            "kind": "crd:podmonitors.monitoring.coreos.com"
        },
        {
            "id": "scrapeconfigs",
            "label": "Scrape Configs",
            "icon": "sliders",
            "kind": "crd:scrapeconfigs.monitoring.coreos.com"
        },
        {
            "id": "rules",
            "label": "Prometheus Rules",
            "icon": "policy",
            "kind": "crd:prometheusrules.monitoring.coreos.com"
        },
        {
            "id": "probes",
            "label": "Probes",
            "icon": "search",
            "kind": "crd:probes.monitoring.coreos.com"
        },
        {
            "id": "thanosrulers",
            "label": "Thanos Rulers",
            "icon": "layers",
            "kind": "crd:thanosrulers.monitoring.coreos.com"
        }
    ],
    "cards": [
        {
            "label": "Prometheus servers",
            "kind": "crd:prometheuses.monitoring.coreos.com",
            "groupBy": "status.conditions[Available]",
            "tones": {
                "True": "ok",
                "False": "error",
                "Degraded": "warn",
                "Unknown": "warn"
            }
        },
        {
            "label": "Alertmanagers",
            "kind": "crd:alertmanagers.monitoring.coreos.com",
            "groupBy": "status.conditions[Available]",
            "tones": {
                "True": "ok",
                "False": "error",
                "Degraded": "warn",
                "Unknown": "warn"
            }
        },
        {
            "label": "Service Monitors",
            "kind": "crd:servicemonitors.monitoring.coreos.com"
        },
        {
            "label": "Pod Monitors",
            "kind": "crd:podmonitors.monitoring.coreos.com"
        },
        {
            "label": "Prometheus Rules",
            "kind": "crd:prometheusrules.monitoring.coreos.com"
        }
    ],
    "charts": [
        {
            "id": "targets-by-job",
            "label": "Scrape targets by job",
            "attach": "overview",
            "unit": "count",
            "legend": "job",
            "description": "How many targets each job is scraping. A job that drops to nothing has lost its endpoints.",
            "query": "count by (job) (up)"
        },
        {
            "id": "targets-down",
            "label": "Targets down",
            "attach": "overview",
            "unit": "count",
            "description": "Targets Prometheus tried and could not scrape. Anything above zero is a metric you are not getting.",
            "query": "count(up == 0) or vector(0)"
        },
        {
            "id": "samples-ingested",
            "label": "Samples ingested",
            "attach": "overview",
            "unit": "ops/s",
            "description": "Samples appended to the head block per second, across every Prometheus. The pulse of the monitoring itself.",
            "query": "sum(rate(prometheus_tsdb_head_samples_appended_total[5m]))"
        },
        {
            "id": "head-series",
            "label": "Series in memory",
            "attach": "overview",
            "unit": "count",
            "description": "Active time series in the head block. Memory follows this line; a sudden climb is usually a label with too many values.",
            "query": "sum(prometheus_tsdb_head_series)"
        },
        {
            "id": "firing-alerts",
            "label": "Firing alerts",
            "attach": "overview",
            "unit": "count",
            "legend": "alertname",
            "description": "Alerts in the firing state, by name. Watchdog is meant to be there: it proves the alerting path is alive.",
            "query": "sum by (alertname) (ALERTS{alertstate=\"firing\"})"
        },
        {
            "id": "pod-cpu",
            "label": "CPU",
            "attach": "pods",
            "unit": "cores",
            "legend": "container",
            "description": "Cores used per container, averaged over five minutes.",
            "query": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",pod=\"$name\",container!=\"\",container!=\"POD\"}[5m]))"
        },
        {
            "id": "pod-memory",
            "label": "Memory",
            "attach": "pods",
            "unit": "bytes",
            "legend": "container",
            "description": "Working set per container \u2014 what the kernel would have to reclaim, which is what the OOM killer looks at.",
            "query": "sum by (container) (container_memory_working_set_bytes{namespace=\"$namespace\",pod=\"$name\",container!=\"\",container!=\"POD\"})"
        },
        {
            "id": "pod-network",
            "label": "Network in",
            "attach": "pods",
            "unit": "bytes/s",
            "description": "Bytes received across all of the pod's interfaces.",
            "query": "sum(rate(container_network_receive_bytes_total{namespace=\"$namespace\",pod=\"$name\"}[5m]))"
        },
        {
            "id": "node-cpu",
            "label": "CPU",
            "attach": "nodes",
            "unit": "cores",
            "description": "Cores used by everything scheduled on this node.",
            "query": "sum(rate(container_cpu_usage_seconds_total{node=\"$name\",container!=\"\"}[5m]))"
        },
        {
            "id": "node-memory",
            "label": "Memory",
            "attach": "nodes",
            "unit": "bytes",
            "description": "Working set of everything scheduled on this node.",
            "query": "sum(container_memory_working_set_bytes{node=\"$name\",container!=\"\"})"
        },
        {
            "id": "node-pods",
            "label": "Pods",
            "attach": "nodes",
            "unit": "count",
            "description": "How many pods are placed here. Needs kube-state-metrics.",
            "query": "count(kube_pod_info{node=\"$name\"})"
        },
        {
            "id": "cluster-cpu",
            "label": "Cluster CPU",
            "attach": "dashboard",
            "unit": "cores",
            "description": "Cores used across every workload in the cluster.",
            "query": "sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[5m]))"
        },
        {
            "id": "cluster-memory",
            "label": "Cluster memory",
            "attach": "dashboard",
            "unit": "bytes",
            "description": "Working set across every workload in the cluster.",
            "query": "sum(container_memory_working_set_bytes{container!=\"\"})"
        },
        {
            "id": "cluster-pods",
            "label": "Pods by phase",
            "attach": "dashboard",
            "unit": "count",
            "legend": "phase",
            "description": "Needs kube-state-metrics. A rising Pending line is the cluster running out of somewhere to put things.",
            "query": "sum by (phase) (kube_pod_status_phase)"
        },
        {
            "id": "apiserver-requests",
            "label": "API server requests",
            "attach": "dashboard",
            "unit": "ops/s",
            "legend": "code",
            "description": "Requests per second by response code, as the API server itself reports them.",
            "query": "sum by (code) (rate(apiserver_request_total[5m]))"
        },
        {
            "id": "cluster-cpu-commitment",
            "label": "CPU requested vs used",
            "attach": "dashboard",
            "unit": "cores",
            "legend": "series",
            "description": "What the scheduler has booked, what those pods may grow into, and what they are really burning. Needs kube-state-metrics. Requested far above used is a cluster paying for room nobody uses; used near limits is a cluster about to throttle.",
            "query": "label_replace(sum(kube_pod_container_resource_requests{resource=\"cpu\"}), \"series\", \"requested\", \"\", \"\") or label_replace(sum(kube_pod_container_resource_limits{resource=\"cpu\"}), \"series\", \"limits\", \"\", \"\") or label_replace(sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[5m])), \"series\", \"used\", \"\", \"\")"
        },
        {
            "id": "cluster-memory-commitment",
            "label": "Memory requested vs used",
            "attach": "dashboard",
            "unit": "bytes",
            "legend": "series",
            "description": "Requested, limits and working set across the cluster. Needs kube-state-metrics. Memory limits are the ones that kill: used approaching limits is an OOM waiting to happen.",
            "query": "label_replace(sum(kube_pod_container_resource_requests{resource=\"memory\"}), \"series\", \"requested\", \"\", \"\") or label_replace(sum(kube_pod_container_resource_limits{resource=\"memory\"}), \"series\", \"limits\", \"\", \"\") or label_replace(sum(container_memory_working_set_bytes{container!=\"\"}), \"series\", \"used\", \"\", \"\")"
        },
        {
            "id": "node-cpu-commitment",
            "label": "CPU requested vs used",
            "attach": "nodes",
            "unit": "cores",
            "legend": "series",
            "description": "What this node has been asked to hold against what it is actually doing. Needs kube-state-metrics.",
            "query": "label_replace(sum(kube_pod_container_resource_requests{resource=\"cpu\",node=\"$node\"}), \"series\", \"requested\", \"\", \"\") or label_replace(sum(kube_pod_container_resource_limits{resource=\"cpu\",node=\"$node\"}), \"series\", \"limits\", \"\", \"\") or label_replace(sum(rate(container_cpu_usage_seconds_total{node=\"$node\",container!=\"\"}[5m])), \"series\", \"used\", \"\", \"\")"
        },
        {
            "id": "node-memory-commitment",
            "label": "Memory requested vs used",
            "attach": "nodes",
            "unit": "bytes",
            "legend": "series",
            "description": "Requested, limits and working set for everything placed on this node. Needs kube-state-metrics.",
            "query": "label_replace(sum(kube_pod_container_resource_requests{resource=\"memory\",node=\"$node\"}), \"series\", \"requested\", \"\", \"\") or label_replace(sum(kube_pod_container_resource_limits{resource=\"memory\",node=\"$node\"}), \"series\", \"limits\", \"\", \"\") or label_replace(sum(container_memory_working_set_bytes{node=\"$node\",container!=\"\"}), \"series\", \"used\", \"\", \"\")"
        },
        {
            "id": "pod-cpu-commitment",
            "label": "CPU requested vs used",
            "attach": "pods",
            "unit": "cores",
            "legend": "series",
            "description": "This pod's own request and limit against what it burns. Needs kube-state-metrics. The clearest place to see a request that was guessed rather than measured.",
            "query": "label_replace(sum(kube_pod_container_resource_requests{resource=\"cpu\",namespace=\"$namespace\",pod=\"$name\"}), \"series\", \"requested\", \"\", \"\") or label_replace(sum(kube_pod_container_resource_limits{resource=\"cpu\",namespace=\"$namespace\",pod=\"$name\"}), \"series\", \"limits\", \"\", \"\") or label_replace(sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",pod=\"$name\",container!=\"\",container!=\"POD\"}[5m])), \"series\", \"used\", \"\", \"\")"
        },
        {
            "id": "pod-memory-commitment",
            "label": "Memory requested vs used",
            "attach": "pods",
            "unit": "bytes",
            "legend": "series",
            "description": "This pod's request and limit against its working set. Needs kube-state-metrics. The working set touching the limit line is what the OOM killer acts on.",
            "query": "label_replace(sum(kube_pod_container_resource_requests{resource=\"memory\",namespace=\"$namespace\",pod=\"$name\"}), \"series\", \"requested\", \"\", \"\") or label_replace(sum(kube_pod_container_resource_limits{resource=\"memory\",namespace=\"$namespace\",pod=\"$name\"}), \"series\", \"limits\", \"\", \"\") or label_replace(sum(container_memory_working_set_bytes{namespace=\"$namespace\",pod=\"$name\",container!=\"\",container!=\"POD\"}), \"series\", \"used\", \"\", \"\")"
        }
    ],
    "usage": {
        "node": {
            "cpu": "sum by (node) (rate(container_cpu_usage_seconds_total{container!=\"\"}[5m]))",
            "memory": "sum by (node) (container_memory_working_set_bytes{container!=\"\"})"
        },
        "pod": {
            "cpu": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{container!=\"\",container!=\"POD\"}[5m]))",
            "memory": "sum by (namespace, pod) (container_memory_working_set_bytes{container!=\"\",container!=\"POD\"})"
        }
    }
}
