        },
        {
            "id": "clusterpreferences",
            "label": "Cluster Preferences",
            "icon": "sliders",
            "kind": "crd:virtualmachineclusterpreferences.instancetype.kubevirt.io"
        },
        {
            "id": "snapshots",
            "label": "Snapshots",
            "icon": "save",
            "kind": "crd:virtualmachinesnapshots.snapshot.kubevirt.io"
        },
        {
            "id": "restores",
