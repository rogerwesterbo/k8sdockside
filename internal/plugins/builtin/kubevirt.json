            "kind": "crd:virtualmachineclones.clone.kubevirt.io"
        },
        {
            "id": "exports",
            "label": "Exports",
            "icon": "download",
            "kind": "crd:virtualmachineexports.export.kubevirt.io"
        },
        {
            "id": "settings",
            "label": "KubeVirt Settings",
            "icon": "settings",
            "kind": "crd:kubevirts.kubevirt.io"
        },
        {
            "id": "cdisettings",
            "label": "CDI Settings",
            "icon": "settings",
            "kind": "crd:cdis.cdi.kubevirt.io"
        },
        {
            "id": "components",
            "label": "KubeVirt's own workloads",
            "icon": "server",
            "kind": "deployments",
            "selector": "kubevirt.io"
        }
    ],
    "cards": [
        {
            "label": "Virtual Machines by state",
            "kind": "crd:virtualmachines.kubevirt.io",
            "groupBy": "status.printableStatus",
            "tones": {
                "Running": "ok",
                "Stopped": "info",
                "Paused": "warn",
                "Starting": "warn",
                "Stopping": "warn",
                "Migrating": "warn",
                "Provisioning": "warn",
                "Terminating": "info",
                "CrashLoopBackOff": "error",
                "ErrorUnschedulable": "error",
                "ErrImagePull": "error",
                "ImagePullBackOff": "error",
                "ErrorPvcNotFound": "error",
                "DataVolumeError": "error",
                "Unknown": "info"
            }
        },
        {
            "label": "Instances by phase",
            "kind": "crd:virtualmachineinstances.kubevirt.io",
            "groupBy": "status.phase",
            "tones": {
                "Running": "ok",
                "Succeeded": "info",
                "Pending": "warn",
                "Scheduling": "warn",
                "Scheduled": "warn",
                "Failed": "error",
                "Unknown": "info"
            }
        },
        {
            "label": "Migrations by phase",
            "kind": "crd:virtualmachineinstancemigrations.kubevirt.io",
            "groupBy": "status.phase",
            "tones": {
                "Succeeded": "ok",
                "Running": "warn",
                "Scheduling": "warn",
                "Scheduled": "warn",
                "PreparingTarget": "warn",
                "TargetReady": "warn",
                "Pending": "warn",
                "Failed": "error"
            }
        },
        {
            "label": "Data Volumes by phase",
            "kind": "crd:datavolumes.cdi.kubevirt.io",
            "groupBy": "status.phase",
            "tones": {
                "Succeeded": "ok",
                "Pending": "warn",
                "ImportScheduled": "warn",
                "ImportInProgress": "warn",
                "CloneScheduled": "warn",
                "CloneInProgress": "warn",
                "UploadScheduled": "warn",
                "UploadReady": "warn",
                "Failed": "error"
            }
        },
        {
            "label": "Snapshots",
            "kind": "crd:virtualmachinesnapshots.snapshot.kubevirt.io",
            "groupBy": "status.phase",
            "tones": {
                "Succeeded": "ok",
                "InProgress": "warn",
                "Failed": "error"
            }
        },
        {
            "label": "Instance Types",
            "kind": "crd:virtualmachineclusterinstancetypes.instancetype.kubevirt.io"
        }
    ],
    "charts": [
        {
            "id": "vmis-by-phase",
            "label": "Virtual machines by phase",
            "attach": "overview",
            "unit": "count",
            "legend": "phase",
            "description": "Every guest KubeVirt knows about, by what it is doing. Running is the one that should be moving; a Scheduling line that does not fall is a VM the cluster cannot place, usually for want of a node with the right devices or enough memory.",
            "query": "sum by (phase) (kubevirt_vmi_phase_count)"
        },
        {
            "id": "vmis-by-node",
            "label": "Running guests by node",
            "attach": "overview",
            "unit": "count",
            "legend": "node",
            "description": "Where the running guests are. VMs do not reschedule the way pods do — a live migration is a deliberate act — so this line is flat until somebody moves something, and a node emptying on its own means something evicted.",
            "query": "sum by (node) (kubevirt_vmi_phase_count{phase=\"Running\"})"
        },
        {
            "id": "migrations-in-flight",
            "label": "Migrations in flight",
            "attach": "overview",
            "unit": "count",
            "legend": "series",
            "description": "Live migrations by the stage they are at. Scheduling that does not become Running is a target node that cannot take the guest; Running that does not end is a guest dirtying memory faster than the link can copy it.",
            "query": "label_replace(sum(kubevirt_vmi_migrations_in_pending_phase), \"series\", \"pending\", \"\", \"\") or label_replace(sum(kubevirt_vmi_migrations_in_scheduling_phase), \"series\", \"scheduling\", \"\", \"\") or label_replace(sum(kubevirt_vmi_migrations_in_running_phase), \"series\", \"running\", \"\", \"\")"
        },
        {
            "id": "guest-cpu-total",
            "label": "Guest CPU",
            "attach": "overview",
            "unit": "cores",
            "description": "Cores burned inside the guests, across the cluster. This is what the VMs are doing, not what their virt-launcher pods were given — the gap between the two is the hypervisor's own overhead.",
            "query": "sum(rate(kubevirt_vmi_cpu_usage_seconds_total[5m]))"
        },
        {
            "id": "guest-memory-total",
            "label": "Guest memory",
            "attach": "overview",
            "unit": "bytes",
            "description": "Memory resident for the guests across the cluster. A VM's memory is claimed up front in a way a container's is not, so this rises when a VM starts rather than when it gets busy.",
            "query": "sum(kubevirt_vmi_memory_resident_bytes)"
        },
        {
            "id": "guest-storage-traffic",
            "label": "Guest disk throughput",
            "attach": "overview",
            "unit": "bytes/s",
            "legend": "series",
            "description": "Bytes the guests read and wrote, across every disk attached to them. Measured inside KubeVirt rather than at the node, so it is the VMs' own traffic and not the cluster's.",
            "query": "label_replace(sum(rate(kubevirt_vmi_storage_read_traffic_bytes_total[5m])), \"series\", \"read\", \"\", \"\") or label_replace(sum(rate(kubevirt_vmi_storage_write_traffic_bytes_total[5m])), \"series\", \"written\", \"\", \"\")"
        },
        {
            "id": "guest-network-traffic",
            "label": "Guest network",
            "attach": "overview",
            "unit": "bytes/s",
            "legend": "series",
            "description": "Bytes in and out of the guests' interfaces across the cluster.",
            "query": "label_replace(sum(rate(kubevirt_vmi_network_receive_bytes_total[5m])), \"series\", \"received\", \"\", \"\") or label_replace(sum(rate(kubevirt_vmi_network_transmit_bytes_total[5m])), \"series\", \"transmitted\", \"\", \"\")"
        },
        {
            "id": "kvm-nodes",
            "label": "Nodes able to run VMs",
            "attach": "overview",
            "unit": "count",
            "legend": "series",
            "description": "How many nodes virt-handler considers usable, and how many of those actually have KVM. A node without KVM can still be scheduled to if software emulation is allowed, and a guest on one is slow in a way nothing else in this app would explain.",
            "query": "label_replace(sum(kubevirt_allocatable_nodes), \"series\", \"allocatable\", \"\", \"\") or label_replace(sum(kubevirt_nodes_with_kvm), \"series\", \"with KVM\", \"\", \"\")"
        },
        {
            "id": "vm-cpu",
            "label": "CPU",
            "attach": "crd:virtualmachines.kubevirt.io",
            "unit": "cores",
            "description": "Cores burned inside the guest, as the hypervisor measures them. This is the VM's own usage, not its virt-launcher pod's — the pod's CPU chart includes the emulator threads and is always the larger number.",
            "query": "sum(rate(kubevirt_vmi_cpu_usage_seconds_total{namespace=\"$namespace\",name=\"$name\"}[5m]))"
        },
        {
            "id": "vmi-cpu",
            "label": "CPU",
            "attach": "crd:virtualmachineinstances.kubevirt.io",
            "unit": "cores",
            "description": "Cores burned inside the guest, as the hypervisor measures them. This is the VM's own usage, not its virt-launcher pod's — the pod's CPU chart includes the emulator threads and is always the larger number.",
            "query": "sum(rate(kubevirt_vmi_cpu_usage_seconds_total{namespace=\"$namespace\",name=\"$name\"}[5m]))"
        },
        {
            "id": "vm-vcpu-wait",
            "label": "vCPU wait",
            "attach": "crd:virtualmachines.kubevirt.io",
            "unit": "seconds",
            "description": "Seconds per second the guest's vCPUs spent waiting for a physical core. This is the reading that says a VM is slow because the node is oversubscribed rather than because the guest is busy — the guest itself cannot see it, and reports a healthy idle percentage while it waits.",
            "query": "sum(rate(kubevirt_vmi_vcpu_wait_seconds_total{namespace=\"$namespace\",name=\"$name\"}[5m]))"
        },
        {
            "id": "vmi-vcpu-wait",
            "label": "vCPU wait",
            "attach": "crd:virtualmachineinstances.kubevirt.io",
            "unit": "seconds",
            "description": "Seconds per second the guest's vCPUs spent waiting for a physical core. This is the reading that says a VM is slow because the node is oversubscribed rather than because the guest is busy — the guest itself cannot see it, and reports a healthy idle percentage while it waits.",
            "query": "sum(rate(kubevirt_vmi_vcpu_wait_seconds_total{namespace=\"$namespace\",name=\"$name\"}[5m]))"
        },
        {
            "id": "vm-memory",
            "label": "Memory",
            "attach": "crd:virtualmachines.kubevirt.io",
            "unit": "bytes",
            "description": "What the guest is holding, on the three readings that differ. Resident is what the host has actually backed; available is what the guest believes it has; usable is what it could still hand out before it starts swapping inside itself. Usable falling towards zero is memory pressure the host cannot see.",
            "query": "label_replace(sum(kubevirt_vmi_memory_resident_bytes{namespace=\"$namespace\",name=\"$name\"}), \"series\", \"resident\", \"\", \"\") or label_replace(sum(kubevirt_vmi_memory_available_bytes{namespace=\"$namespace\",name=\"$name\"}), \"series\", \"available\", \"\", \"\") or label_replace(sum(kubevirt_vmi_memory_usable_bytes{namespace=\"$namespace\",name=\"$name\"}), \"series\", \"usable\", \"\", \"\")",
            "legend": "series"
        },
        {
            "id": "vmi-memory",
            "label": "Memory",
            "attach": "crd:virtualmachineinstances.kubevirt.io",
            "unit": "bytes",
            "description": "What the guest is holding, on the three readings that differ. Resident is what the host has actually backed; available is what the guest believes it has; usable is what it could still hand out before it starts swapping inside itself. Usable falling towards zero is memory pressure the host cannot see.",
            "query": "label_replace(sum(kubevirt_vmi_memory_resident_bytes{namespace=\"$namespace\",name=\"$name\"}), \"series\", \"resident\", \"\", \"\") or label_replace(sum(kubevirt_vmi_memory_available_bytes{namespace=\"$namespace\",name=\"$name\"}), \"series\", \"available\", \"\", \"\") or label_replace(sum(kubevirt_vmi_memory_usable_bytes{namespace=\"$namespace\",name=\"$name\"}), \"series\", \"usable\", \"\", \"\")",
            "legend": "series"
        },
        {
            "id": "vm-storage",
            "label": "Disk throughput",
            "attach": "crd:virtualmachines.kubevirt.io",
            "unit": "bytes/s",
            "description": "Bytes read and written per disk attached to this guest.",
            "query": "label_replace(sum(rate(kubevirt_vmi_storage_read_traffic_bytes_total{namespace=\"$namespace\",name=\"$name\"}[5m])), \"series\", \"read\", \"\", \"\") or label_replace(sum(rate(kubevirt_vmi_storage_write_traffic_bytes_total{namespace=\"$namespace\",name=\"$name\"}[5m])), \"series\", \"written\", \"\", \"\")",
            "legend": "series"
        },
        {
            "id": "vmi-storage",
            "label": "Disk throughput",
            "attach": "crd:virtualmachineinstances.kubevirt.io",
            "unit": "bytes/s",
            "description": "Bytes read and written per disk attached to this guest.",
            "query": "label_replace(sum(rate(kubevirt_vmi_storage_read_traffic_bytes_total{namespace=\"$namespace\",name=\"$name\"}[5m])), \"series\", \"read\", \"\", \"\") or label_replace(sum(rate(kubevirt_vmi_storage_write_traffic_bytes_total{namespace=\"$namespace\",name=\"$name\"}[5m])), \"series\", \"written\", \"\", \"\")",
            "legend": "series"
        },
        {
            "id": "vm-iops",
            "label": "Disk IOPS",
            "attach": "crd:virtualmachines.kubevirt.io",
            "unit": "ops/s",
            "description": "Read and write operations per second. Throughput says how much is moving; this says how often, and a guest doing many small writes can saturate a disk while its throughput chart looks idle.",
            "query": "label_replace(sum(rate(kubevirt_vmi_storage_iops_read_total{namespace=\"$namespace\",name=\"$name\"}[5m])), \"series\", \"read\", \"\", \"\") or label_replace(sum(rate(kubevirt_vmi_storage_iops_write_total{namespace=\"$namespace\",name=\"$name\"}[5m])), \"series\", \"write\", \"\", \"\")",
            "legend": "series"
        },
        {
            "id": "vmi-iops",
            "label": "Disk IOPS",
            "attach": "crd:virtualmachineinstances.kubevirt.io",
            "unit": "ops/s",
            "description": "Read and write operations per second. Throughput says how much is moving; this says how often, and a guest doing many small writes can saturate a disk while its throughput chart looks idle.",
            "query": "label_replace(sum(rate(kubevirt_vmi_storage_iops_read_total{namespace=\"$namespace\",name=\"$name\"}[5m])), \"series\", \"read\", \"\", \"\") or label_replace(sum(rate(kubevirt_vmi_storage_iops_write_total{namespace=\"$namespace\",name=\"$name\"}[5m])), \"series\", \"write\", \"\", \"\")",
            "legend": "series"
        },
        {
            "id": "vm-network",
            "label": "Network",
            "attach": "crd:virtualmachines.kubevirt.io",
            "unit": "bytes/s",
            "description": "Bytes in and out of this guest's interfaces.",
            "query": "label_replace(sum(rate(kubevirt_vmi_network_receive_bytes_total{namespace=\"$namespace\",name=\"$name\"}[5m])), \"series\", \"received\", \"\", \"\") or label_replace(sum(rate(kubevirt_vmi_network_transmit_bytes_total{namespace=\"$namespace\",name=\"$name\"}[5m])), \"series\", \"transmitted\", \"\", \"\")",
            "legend": "series"
        },
        {
            "id": "vmi-network",
            "label": "Network",
            "attach": "crd:virtualmachineinstances.kubevirt.io",
            "unit": "bytes/s",
            "description": "Bytes in and out of this guest's interfaces.",
            "query": "label_replace(sum(rate(kubevirt_vmi_network_receive_bytes_total{namespace=\"$namespace\",name=\"$name\"}[5m])), \"series\", \"received\", \"\", \"\") or label_replace(sum(rate(kubevirt_vmi_network_transmit_bytes_total{namespace=\"$namespace\",name=\"$name\"}[5m])), \"series\", \"transmitted\", \"\", \"\")",
            "legend": "series"
        },
        {
            "id": "migration-progress",
            "label": "Memory left to copy",
            "attach": "crd:virtualmachineinstancemigrations.kubevirt.io",
            "unit": "bytes",
            "legend": "series",
            "description": "A live migration copies the guest's memory to the target while the guest keeps writing to it. Processed climbing with remaining flat is a guest dirtying pages as fast as the link can move them — the migration that never converges, and the reason for a post-copy or an auto-converge setting. Labelled by the guest, so a migration draws once its VMI is named in its status.",
            "query": "label_replace(sum(kubevirt_vmi_migration_data_processed_bytes{namespace=\"$namespace\"}), \"series\", \"processed\", \"\", \"\") or label_replace(sum(kubevirt_vmi_migration_data_remaining_bytes{namespace=\"$namespace\"}), \"series\", \"remaining\", \"\", \"\")"
        }
    ]
}
