{
    "id": "argocd-ui",
    "name": "Argo CD map",
    "tagline": "an example plugin with a view of its own",
    "icon": "share",
    "docs": "https://argo-cd.readthedocs.io/",
    "description": "Every Application as a card with its health and sync state, unfolding into the resources it manages. An example of a custom view: the page lives in ui/ beside this file and talks to the app through the k8sdockside bridge.",
    "requires": [
        { "kind": "crd:applications.argoproj.io", "label": "Applications" }
    ],
    "ui": {
        "kinds": [
            "deployments",
            "statefulsets",
            "daemonsets",
            "services",
            "ingresses",
            "configmaps",
            "jobs",
            "cronjobs",
            "pods"
        ],
        "write": true
    },
    "views": [
        { "id": "map", "label": "Application map", "icon": "share", "type": "custom" },
        { "id": "applications", "label": "Applications", "icon": "rocket", "kind": "crd:applications.argoproj.io" }
    ],
    "cards": [
        {
            "label": "Health",
            "kind": "crd:applications.argoproj.io",
            "groupBy": "status.health.status",
            "tones": { "Healthy": "ok", "Progressing": "info", "Degraded": "error", "Missing": "warn", "Suspended": "warn" }
        }
    ]
}
