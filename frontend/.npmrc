# Refuse to install package versions published less than 7 days ago, reducing
# exposure to freshly compromised or malicious releases.
#
# npm implements this as `min-release-age`, counted in DAYS. pnpm and bun spell
# it `minimum-release-age` and count MINUTES -- the same 7 days is 10080 there.
# Both spellings cannot sit in this file: npm 12 warns on config it does not
# recognise, which is what `minimum-release-age` had become. If this project
# ever moves to pnpm or bun, the key and the number both have to change.
min-release-age=7

# Skip the automatic security audit on every `npm install`.
#
# The audit POSTs the whole dependency tree to registry.npmjs.org and waits for
# the reply, which is intermittently slow and sometimes never answers at all:
# measured here at 0.4s without it against 75s and then an indefinite hang with
# it, on an otherwise healthy connection. That request is on the critical path
# of `wails3 dev`, which runs `npm install` before every build, so a stalled
# audit reads as "the app will not start".
#
# Nothing is given up. The audit still runs, deliberately and where its latency
# is the point rather than an obstacle: `make npm-audit`, and `make audit`
# alongside gosec and govulncheck.
audit=false

# A bound on every other registry request, so a stalled connection fails and
# retries instead of hanging a build forever. npm's default is no timeout.
fetch-timeout=60000
fetch-retries=3
