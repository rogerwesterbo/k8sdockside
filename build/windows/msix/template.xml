<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="k8sdockside"
        Arguments=""
        InstallLocation="C:\Program Files\K8s Dockside">
    </Installer>
    <PackageInformation
        PackageName="io.github.rogerwesterbo.k8sdockside"
        PackageDisplayName="K8s Dockside"
        PublisherName="CN=Roger Westerbø"
        PublisherDisplayName="Roger Westerbø"
        Version="0.0.1.0"
        PackageDescription="A Kubernetes workspace for your local kubeconfig contexts">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="K8sDockside"
                Description="A Kubernetes workspace for your local kubeconfig contexts"
                DisplayName="K8s Dockside"
                ExecutableName="k8sdockside"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>K8s Dockside</DisplayName>
            <PublisherDisplayName>Roger Westerbø</PublisherDisplayName>
            <Description>A Kubernetes workspace for your local kubeconfig contexts</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="k8sdockside.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
